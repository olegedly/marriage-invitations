{
  "name": "marriage-invitations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace @marriage-invitations/client && npm run build --workspace @marriage-invitations/server",
    "dev": "npm run dev --workspace @marriage-invitations/server",
    "dev:client": "npm run dev --workspace @marriage-invitations/client",
    "test": "npm test --workspace @marriage-invitations/server",
    "start": "npm start --workspace @marriage-invitations/server"
  }
}
